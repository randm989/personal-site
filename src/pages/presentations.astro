---
import Base from '../layouts/Base.astro';

const talks = [
  {
    href: '/presentations/idea-to-game.html',
    kind: 'Keynote',
    title: 'Idea to Game',
    blurb: 'How Zipix turns a one-line idea into a live micro-game. The scars that became rules, the skills that run the studio, and the pipeline that ships a game in three commits.',
  },
  {
    href: '/presentations/define-the-fun.html',
    kind: 'Keynote',
    title: 'Define the Fun',
    blurb: 'What makes something fun, which fun lasts, and how to ride it. Three beliefs about the edge of order and chaos, the weight of responsibility, and the wave that carries both.',
  },
  {
    href: '/talks/leadership-keynote.html',
    kind: 'Keynote',
    title: 'Leadership Keynote',
    blurb: 'How I build and lead engineering teams, drawn from fifteen years across six studios. The full talk, as a self-contained deck.',
  },
  {
    href: '/presentations/six-principles.html',
    kind: 'Keynote',
    title: 'How I Lead · Six Principles',
    blurb: 'The six principles I actually use, each one paired with the story that proves it. Written down so I stop trusting memory.',
  },
  {
    href: '/presentations/ai-in-games.html',
    kind: 'Point of view',
    title: 'AI in Games',
    blurb: 'Where AI belongs in making games, and where it does not. The next abstraction on the craft, not the end of it.',
  },
  {
    href: '/talks/zipix-lean-ops-case-study.html',
    kind: 'Case study',
    title: 'Zipix · Lean Ops',
    blurb: 'A walk through the production system behind Zipix, from one fix to the runbooks and gates that make a solo studio ship like a team.',
  },
];
---
<Base title="Presentations · Josh Rutz" description="Presentations and decks I've made.">
  <header class="hero"><div class="wrap">
    <div class="eyebrow reveal">Presentations</div>
    <h1 class="reveal">Presentations I've made.</h1>
    <p class="lede reveal">Each one stands on its own. Open it and it's the whole thing.</p>
  </div></header>

  <section><div class="wrap">
    <div class="talks">
      {talks.map((t) => (
        <a class="talk reveal" href={t.href} target="_blank" rel="noopener">
          <div>
            <div class="tk-kind">{t.kind}</div>
            <h3>{t.title}</h3>
            <p>{t.blurb}</p>
          </div>
          <span class="arrow">→</span>
        </a>
      ))}
    </div>
  </div></section>
</Base>
