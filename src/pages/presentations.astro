---
import Base from '../layouts/Base.astro';
---
<Base title="Talks — Josh Rutz" description="Talks and decks I've made.">
  <header class="hero"><div class="wrap">
    <div class="eyebrow reveal">Talks &amp; presentations</div>
    <h1 class="reveal">Talks and decks I've made.</h1>
    <p class="lede reveal">Each one stands on its own.</p>
  </div></header>

  <section><div class="wrap">
    <div class="label reveal">The decks<span class="rule"></span></div>
    <p class="body reveal">Drop your HTML decks into <code>public/presentations/</code> and they're served as
      themselves, indexed here.</p>
  </div></section>
</Base>
