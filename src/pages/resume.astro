---
import Base from '../layouts/Base.astro';
---
<Base title="Resume — Josh Rutz" description="My resume, the way I'd actually tell it.">
  <header class="hero"><div class="wrap">
    <div class="eyebrow reveal">Resume</div>
    <h1 class="reveal">My resume, the way I'd actually tell it.</h1>
    <p class="lede reveal">The short version is on paper if you need it.</p>
    <div class="cta reveal">
      <a class="btn" href="/resume.pdf">Download PDF</a>
    </div>
  </div></header>

  <section><div class="wrap">
    <div class="label reveal">In progress<span class="rule"></span></div>
    <p class="body reveal">The interactive version is being built from the real resume. Hand it over and
      this becomes the explorable telling, with a clean PDF for the people who just need the facts fast.</p>
  </div></section>
</Base>
