---
import Base from '../../layouts/Base.astro';
---
<Base title="Work — Josh Rutz" description="The work is the proof.">
  <header class="hero"><div class="wrap">
    <div class="eyebrow reveal">The work</div>
    <h1 class="reveal">The proof is what I build.</h1>
    <p class="lede reveal">Each of these is a belief I hold, built into something real.</p>
  </div></header>

  <section><div class="wrap">
    <div class="panel-grid">
      <a class="panel reveal" href="https://playzipix.app">
        <div class="kind">Platform</div><h3>Zipix</h3>
        <p>A mobile-first micro-game platform. Every game is one complete experience in about a minute. You pick it up, you finish something, you put it down.</p>
      </a>
      <div class="panel reveal">
        <div class="kind">More soon</div><h3>(next project)</h3>
        <p>One file per project. Hand me a blurb and it becomes a page here.</p>
      </div>
    </div>
  </div></section>
</Base>
